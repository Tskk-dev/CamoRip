<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- x64 matches the native Media Foundation provider and decoder DLLs -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniversalCam.Core\UniversalCam.Core.csproj" />
    <ProjectReference
      Include="..\..\src\UniversalCam.VirtualCamera\UniversalCam.VirtualCamera.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/*.h264" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <Compile Include="..\..\src\UniversalCam\DiagnosticFileLog.cs" Link="Desktop/DiagnosticFileLog.cs" />
    <Compile Include="..\..\src\UniversalCam\AppSettings.cs" Link="Desktop/AppSettings.cs" />
    <None Include="..\..\artifacts\decoder\$(Configuration)\UniversalCam.Decoder.dll"
          Link="UniversalCam.Decoder.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\decoder\$(Configuration)\UniversalCam.Decoder.dll')" />
  </ItemGroup>

</Project>
