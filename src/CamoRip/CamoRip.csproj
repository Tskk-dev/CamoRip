<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <EnableMsixTooling>false</EnableMsixTooling>
        <PlatformTarget>x64</PlatformTarget>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>CamoRip</AssemblyName>
        <Version>0.4.0</Version>

        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>CamoRip</RootNamespace>

        <!-- x64 only for Phase 1–3 -->
        <Platforms>x64</Platforms>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

        <!-- Per-monitor DPI awareness -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>camorip.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="camorip.ico" CopyToOutputDirectory="PreserveNewest" />
        <PackageReference Include="QRCoder" Version="1.8.0" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CamoRip.Core\CamoRip.Core.csproj" />
        <ProjectReference Include="..\CamoRip.VirtualCamera\CamoRip.VirtualCamera.csproj" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Audio\**\*.cs" />
        <None Include="..\..\artifacts\decoder\$(Configuration)\CamoRip.Decoder.dll"
              Link="CamoRip.Decoder.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('..\..\artifacts\decoder\$(Configuration)\CamoRip.Decoder.dll')" />
        <None Include="..\..\artifacts\native\$(Configuration)\CamoRipMediaSource.dll"
              Link="CamoRipMediaSource.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('..\..\artifacts\native\$(Configuration)\CamoRipMediaSource.dll')" />
    </ItemGroup>
    <!-- Unpackaged WinUI publish currently omits the application's PRI/XBF files.
         Include generated output explicitly, preserving relative XAML paths. -->
    <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
        <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="Application PRI was not generated." />
        <Error Condition="!Exists('$(TargetDir)Views\MainWindow.xbf')" Text="Compiled window XAML was not generated." />
        <ItemGroup>
            <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
                <RelativePath>$(AssemblyName).pri</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <_ApplicationXbf Include="$(TargetDir)**\*.xbf" />
            <ResolvedFileToPublish Include="@(_ApplicationXbf)">
                <RelativePath>%(_ApplicationXbf.RecursiveDir)%(_ApplicationXbf.Filename)%(_ApplicationXbf.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
