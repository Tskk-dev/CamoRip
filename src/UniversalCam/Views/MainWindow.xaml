<Window x:Class="UniversalCam.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CamoRip">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <StackPanel x:Name="TopBar" Orientation="Horizontal" Margin="16,8" Spacing="12">
   <Button Click="OnPaneToggle" AutomationProperties.Name="Toggle sidebar"><SymbolIcon Symbol="GlobalNavigationButton" /></Button>
   <TextBlock Text="CamoRip" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
  </StackPanel>
  <InfoBar x:Name="ConnectionNotice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" Margin="16,0,16,8" />
  <SplitView x:Name="Navigation" Grid.Row="2" DisplayMode="CompactInline" IsPaneOpen="True" OpenPaneLength="340" CompactPaneLength="0">
   <SplitView.Pane>
    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <ListView x:Name="MenuSelection" SelectionMode="Single" SelectionChanged="OnNavigation" Margin="8,8,8,0" AutomationProperties.Name="CamoRip sections">
      <ListViewItem Tag="camera"><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="Camera" /><TextBlock Text="Camera" /></StackPanel></ListViewItem>
      <ListViewItem Tag="adjustments"><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="Edit" /><TextBlock Text="Camera adjustments" /></StackPanel></ListViewItem>
      <ListViewItem Tag="preview"><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="View" /><TextBlock Text="Preview" /></StackPanel></ListViewItem>
      <ListViewItem Tag="settings"><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="Setting" /><TextBlock Text="Settings" /></StackPanel></ListViewItem>
     </ListView>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="20,16,20,24" Spacing="16">
      <TextBlock x:Name="ControlStatus" Text="Connect a compatible iPhone app" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
      <StackPanel x:Name="CameraPage" Spacing="16">
       <TextBlock Text="Camera" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock x:Name="DeviceStatus" Text="Connect your iPhone over USB" TextWrapping="Wrap" />
       <Button x:Name="StreamButton" Content="Start video" Click="OnToggleStream" IsEnabled="False" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
       <Button x:Name="SwitchCamera" Content="Switch camera" Click="OnSwitchCamera" IsEnabled="False" HorizontalAlignment="Stretch" />
       <ComboBox x:Name="CaptureMode" Header="Resolution and frame rate" SelectionChanged="OnCaptureMode" HorizontalAlignment="Stretch" IsEnabled="False" />
       <TextBlock x:Name="CaptureModeHint" Text="Connect the updated iPhone app to choose a video mode." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       <ComboBox x:Name="Quality" Header="Video quality" SelectionChanged="OnQualitySelection" HorizontalAlignment="Stretch" IsEnabled="False" />
       <NumberBox x:Name="CustomBitrate" Header="Custom bitrate (Mbps)" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" Value="20" ValueChanged="OnCustomBitrate" Visibility="Collapsed" />
       <Button x:Name="ApplyQuality" Content="Apply quality" Click="OnApplyQuality" HorizontalAlignment="Stretch" IsEnabled="False" />
       <TextBlock x:Name="QualityHint" Text="Balanced preserves the current bitrate. Higher bitrates may improve detail and increase bandwidth." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       <ToggleSwitch x:Name="Torch" Header="Torch" Toggled="OnTorch" IsEnabled="False" />
       <Slider x:Name="TorchLevel" Header="Torch brightness" Minimum="0.01" Maximum="1" StepFrequency="0.01" Value="0.5" ValueChanged="OnTorchLevel" IsEnabled="False" AutomationProperties.Name="Torch brightness" />
       <TextBlock x:Name="TorchValue" Text="50%" />
       <TextBlock x:Name="VideoStatus" Text="1080p · 60 fps" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel x:Name="AdjustmentsPage" Spacing="12" Visibility="Collapsed">
       <TextBlock Text="Camera adjustments" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <TextBlock Text="Applied on your iPhone" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       <ContentControl x:Name="Adjustments" IsEnabled="False" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
        <Slider x:Name="ExposureBias" Header="Exposure compensation (EV)" Minimum="-2" Maximum="2" StepFrequency="0.1" ValueChanged="OnAdjustment" Tag="exposure_bias" AutomationProperties.Name="Exposure compensation in EV" />
        <ToggleSwitch x:Name="AutoExposure" Header="Automatic exposure" IsOn="True" Toggled="OnExposureMode" />
        <Slider x:Name="Iso" Header="ISO" Minimum="25" Maximum="1600" Value="100" ValueChanged="OnAdjustment" Tag="iso" AutomationProperties.Name="ISO" />
        <Slider x:Name="Shutter" Header="Exposure duration (ms)" Minimum="0.1" Maximum="16.667" Value="8" StepFrequency="0.1" ValueChanged="OnAdjustment" Tag="shutter_ms" AutomationProperties.Name="Exposure duration in milliseconds" />
        <ToggleSwitch x:Name="AutoFocus" Header="Automatic focus" IsOn="True" Toggled="OnFocusMode" />
        <Slider x:Name="Focus" Header="Manual focus" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="OnAdjustment" Tag="focus" AutomationProperties.Name="Manual lens position" />
        <ToggleSwitch x:Name="AutoWhiteBalance" Header="Automatic white balance" IsOn="True" Toggled="OnWhiteBalanceMode" />
        <Slider x:Name="Temperature" Header="Temperature (K)" Minimum="2500" Maximum="8000" Value="5000" StepFrequency="50" ValueChanged="OnAdjustment" Tag="temperature" AutomationProperties.Name="White balance temperature in Kelvin" />
        <Slider x:Name="Tint" Header="Tint" Minimum="-150" Maximum="150" StepFrequency="1" ValueChanged="OnAdjustment" Tag="tint" AutomationProperties.Name="White balance tint" />
        <Button Content="Reset to Auto" Click="OnReset" HorizontalAlignment="Stretch" />
       </StackPanel></ContentControl>
      </StackPanel>
      <StackPanel x:Name="PreviewPage" Spacing="16" Visibility="Collapsed">
       <TextBlock Text="Preview" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <ComboBox x:Name="PreviewRate" Header="Preview frame rate" SelectedIndex="0" SelectionChanged="OnPreviewOptions" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="60 fps" Tag="60" /><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="15 fps" Tag="15" /><ComboBoxItem Content="Off" Tag="0" />
       </ComboBox>
       <ToggleSwitch x:Name="FillPreview" Header="Fill preview" Toggled="OnPreviewOptions" />
       <ToggleSwitch x:Name="MirrorPreview" Header="Mirror preview" Toggled="OnPreviewOptions" />
       <Button Content="Fullscreen preview" Click="OnFullscreen" HorizontalAlignment="Stretch" />
       <TextBlock Text="Preview settings only affect this window. Webcam output continues when the preview is hidden." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel x:Name="SettingsPage" Spacing="16" Visibility="Collapsed">
       <TextBlock Text="Settings" Style="{ThemeResource SubtitleTextBlockStyle}" />
       <ToggleSwitch x:Name="CloseToTray" Header="Close to system tray" Toggled="OnSettings" />
       <ToggleSwitch x:Name="StartMinimized" Header="Start in system tray" Toggled="OnSettings" />
       <ToggleSwitch x:Name="LaunchAtSignIn" Header="Launch at Windows sign-in" Toggled="OnSettings" />
       <ToggleSwitch x:Name="Logging" Header="Diagnostic logging" Toggled="OnSettings" />
       <Button Content="Open logs" Click="OnOpenLogs" HorizontalAlignment="Stretch" />
       <Button Content="Exit CamoRip" Click="OnExit" HorizontalAlignment="Stretch" />
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    </Grid>
   </SplitView.Pane>
   <Grid x:Name="PreviewLayout" Padding="24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border x:Name="PreviewBorder" Background="Black" CornerRadius="12">
     <Grid>
      <SwapChainPanel x:Name="Preview" SizeChanged="OnPreviewSize" />
      <TextBlock x:Name="Waiting" Text="Waiting for USB video" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" />
      <Button x:Name="FullscreenExit" Content="Exit fullscreen" Click="OnFullscreen" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed" />
     </Grid>
    </Border>
    <TextBlock Grid.Row="1" x:Name="PerformanceStatus" Text="Ready when you are" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Expander x:Name="ConnectionDetails" Grid.Row="2" Header="Connection details" HorizontalAlignment="Stretch">
     <StackPanel Spacing="8"><TextBlock x:Name="PerformanceDetails" TextWrapping="Wrap" /><TextBlock x:Name="Diagnostic" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock x:Name="CameraStatus" TextWrapping="Wrap" /><TextBlock x:Name="DecoderStatus" TextWrapping="Wrap" /></StackPanel>
    </Expander>
   </Grid>
  </SplitView>
 </Grid>
</Window>
