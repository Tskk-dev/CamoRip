<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>

        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>UniversalCam</RootNamespace>

        <!-- x64 only for Phase 1–3 -->
        <Platforms>x64</Platforms>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

        <!-- Per-monitor DPI awareness -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>universal_cam.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="universal_cam.ico" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\UniversalCam.Core\UniversalCam.Core.csproj" />
        <ProjectReference Include="..\UniversalCam.VirtualCamera\UniversalCam.VirtualCamera.csproj" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Audio\**\*.cs" />
        <None Include="..\..\artifacts\decoder\$(Configuration)\UniversalCam.Decoder.dll"
              Link="UniversalCam.Decoder.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('..\..\artifacts\decoder\$(Configuration)\UniversalCam.Decoder.dll')" />
        <None Include="..\..\artifacts\native\$(Configuration)\UCamMediaSource.dll"
              Link="UCamMediaSource.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="Exists('..\..\artifacts\native\$(Configuration)\UCamMediaSource.dll')" />
    </ItemGroup>
</Project>
